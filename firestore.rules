rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Является ли текущий пользователь участником чата
    function isMember(chatId) {
      return isSignedIn()
        && request.auth.uid in
           get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Профили пользователей: читать может любой авторизованный,
    // менять — только владелец своего документа
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты: доступ только участникам.
    // resource == null разрешает чтение НЕсуществующего документа — это нужно
    // транзакции отправки (tx.get проверяет, создан ли чат) и безопасно,
    // т.к. отсутствующий документ не содержит данных.
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members;
    }

    // Звонки. Участникам разрешён read/write, плюс ICE-кандидаты
    // в подколлекциях callerCandidates / calleeCandidates.
    //
    // Правило сознательно сверяется по тем же полям (callerUid/calleeUid),
    // что и query subscribeIncomingCalls — иначе Firestore не сможет
    // статически доказать, что query ограничивает выдачу разрешёнными
    // документами, и отклонит подписку с permission-denied.
    match /calls/{callId} {
      function isParticipant() {
        return isSignedIn() && (
          resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid
        );
      }

      allow read, update: if isParticipant();
      allow create: if isSignedIn()
        && request.resource.data.callerUid == request.auth.uid;

      // ICE-кандидаты в подколлекциях callerCandidates / calleeCandidates
      match /{candidates}/{candId} {
        function inParentCall() {
          return isSignedIn() && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          );
        }
        allow read, create: if inParentCall();
      }
    }

    // Сообщения
    match /messages/{messageId} {
      // Читать может только участник чата
      allow read: if isMember(resource.data.chatId);

      // Создавать можно только сообщение от своего имени.
      // (Проверку членства при создании не делаем, т.к. при отправке
      //  первого сообщения чат создаётся в той же транзакции и ещё
      //  не виден правилам — защищаемся проверкой senderId.)
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId;

      // Обновлять — участникам, и только безопасные поля:
      // реакции, статус прочтения, скрытие сообщения у себя
      allow update: if isMember(resource.data.chatId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'status', 'deletedFor']);

      // Удалить у всех может только автор сообщения
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.senderId;
    }
  }
}
